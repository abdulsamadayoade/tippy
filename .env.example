# Postgres
DATABASE_URL="postgresql://user:password@your-neon-host/neondb?sslmode=require"

# Auth (better-auth) — generate the secret with: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Sign-in link emails (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="Tippy <onboarding@yourdomain.com>"

# Avatar uploads (Vercel Blob)
BLOB_STORE_ID="store_..."
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Monnify — from the dashboard: Developers → API Keys & Contracts
MONNIFY_API_KEY="MK_TEST_..."
MONNIFY_SECRET_KEY="..."
MONNIFY_CONTRACT_CODE="..."
MONNIFY_BASE_URL="https://sandbox.monnify.com"
# Your Monnify wallet account number (dashboard → Transfers) — funds disbursements
MONNIFY_SOURCE_ACCOUNT_NUMBER="..."

# Guards /api/cron/payouts — generate with: openssl rand -hex 32
CRON_SECRET="replace-with-a-long-random-string"

# Error tracking (Sentry). The DSN is safe to expose; leave empty to disable locally.
NEXT_PUBLIC_SENTRY_DSN=""
# Sentry org/project slugs used for source-map uploads at build time
SENTRY_ORG="tippy"
SENTRY_PROJECT="tippy"
# Source-map uploads during Vercel/CI builds (Sentry → Settings → Auth Tokens).
# Optional locally — builds succeed without it.
SENTRY_AUTH_TOKEN=""
# Optional override for the Sentry environment tag: local | staging | production
# (auto-detected from VERCEL_ENV when unset)
# SENTRY_ENVIRONMENT="local"
